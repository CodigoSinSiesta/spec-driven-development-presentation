---
import PresentationLayout from '../layouts/PresentationLayout.astro';
import Navigation from '../components/Navigation.svelte';
import Slide01Hero from '../components/slides/Slide01Hero.svelte';
import Slide02TheProblem from '../components/slides/Slide02TheProblem.svelte';
import Slide03Definition from '../components/slides/Slide03Definition.svelte';
import Slide04ThreeLevels from '../components/slides/Slide04ThreeLevels.svelte';
import Slide05Benefits from '../components/slides/Slide05Benefits.svelte';
import Slide06WhenToUse from '../components/slides/Slide06WhenToUse.svelte';
import Slide07WhenNotToUse from '../components/slides/Slide07WhenNotToUse.svelte';
import Slide08Methodologies from '../components/slides/Slide08Methodologies.svelte';
import Slide09Example from '../components/slides/Slide09Example.svelte';
import Slide10Closing from '../components/slides/Slide10Closing.svelte';
---

<PresentationLayout title="Spec-Driven Development (SDD)">
  <Navigation client:load>
    <Slide01Hero client:load />
    <Slide02TheProblem client:load />
    <Slide03Definition client:load />
    <Slide04ThreeLevels client:load />
    <Slide05Benefits client:load />
    <Slide06WhenToUse client:load />
    <Slide07WhenNotToUse client:load />
    <Slide08Methodologies client:load />
    <Slide09Example client:load />
    <Slide10Closing client:load />
  </Navigation>
</PresentationLayout>
